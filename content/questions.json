    { "id": "rfVerify", "question": "Can you independently verify their claims?", "options": ["No way to verify independently", "Partial verification possible", "Easily verifiable"] },
    { "id": "rfAgreement", "question": "Will they put everything in a written, stamped agreement?", "options": ["No written agreement offered", "Verbal promises, vague documents", "Yes, proper stamped agreement"] }
